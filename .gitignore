############################
# Environment files (NEVER COMMIT SENSITIVE KEYS)
############################
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example

############################
# Dependencies
############################
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json

############################
# Python & Virtual Environments
############################
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/

############################
# Logs
############################
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

############################
# Secrets & Firebase
############################
firebase-service-account*.json
**/firebase-service-account*.json

############################
# Build output
############################
dist/
**/dist/
build/
**/build/
frontend/dist/
frontend/build/
backend/dist/

############################
# OS / Editor
############################
.DS_Store
Thumbs.db
.vscode/
.idea/
.pm2/
